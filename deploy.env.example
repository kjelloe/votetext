# Server settings for scripts/deploy.sh — copy to deploy.env (gitignored) and fill in.
# Any of these can also be given as environment variables; the environment wins.
DEPLOY_HOST=deploy@votetext.example.com
DEPLOY_SSH_PORT=2222
# absolute path — no ~ or $HOME expansion
DEPLOY_SSH_KEY=/home/you/.ssh/id_ed25519_deploy
DEPLOY_APP_DIR=/opt/votetext
DEPLOY_SERVICE=votetext
DEPLOY_PUBLIC_URL=https://votetext.example.com
DEPLOY_ENV_FILE=.env.prod
