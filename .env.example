# VoteText — environment configuration
# Copy to .env and adjust:  cp .env.example .env
# Every variable is optional in development. Production requires SESSION_SECRET,
# RESEND_API_KEY and VOTETEXT_URL (the server refuses to start without them).

# --- Application ---
NODE_ENV=development
PORT=3000
VOTETEXT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_PATH=./data/votetext.db

# --- Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_LIFETIME_HOURS=72

# --- Email (Resend) ---
# Leave empty in development: codes and invites are printed to the console
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=VoteText

# --- Sign-in ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
# Code requests per email per 15 minutes, and wrong codes before a code is invalidated
OTP_MAX_ATTEMPTS=5
# Sign-in requests (code requests + code checks) per client address per window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# open = anyone can sign in; invited = only existing accounts and SIGNUP_ALLOWLIST
SIGNUP_MODE=open
# Comma-separated emails or @domains, used when SIGNUP_MODE=invited
SIGNUP_ALLOWLIST=

# --- Documents ---
DEFAULT_LINES_PER_PAGE=30
MAX_DOCUMENT_CHARS=1000000
MAX_PAGES=200

# --- Discussion ---
COMMENT_EDIT_WINDOW_MINUTES=30
COMMENT_COOLDOWN_SECONDS=5
VARIANT_COOLDOWN_SECONDS=5
COMMENT_HEAT_ORANGE=10
COMMENT_HEAT_RED=25
PROPOSALS_TOP_PERCENT=10

# --- Voting ---
VOTING_COUNTDOWN_DEFAULT_MINUTES=5
TOAST_DISMISS_SECONDS=30
